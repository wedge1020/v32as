@echo off
REM Generated by v32as. Edit the sources (or delete this line and keep a hand-written script)
REM rather than this file: it is rewritten by v32as --build-scripts.
REM Set V32AS, V32OPT, PACKROM, PNG2VIRCON or WAV2VIRCON to use a tool that is not in the PATH,
REM and V32OPT_FLAGS (default -O3) to change how v32opt optimizes.

cd /d "%~dp0"
REM tell any v32as started from here not to rewrite the scripts that are running
set V32AS_BUILD_SCRIPT=1

if not defined V32AS set "V32AS=v32as"
if not defined PACKROM set "PACKROM=packrom"
if not defined V32OPT set "V32OPT=v32opt"
if not defined V32OPT_FLAGS set "V32OPT_FLAGS=-O3"
if not defined PNG2VIRCON set "PNG2VIRCON=png2vircon"
if not defined WAV2VIRCON set "WAV2VIRCON=wav2vircon"

REM the tools this build needs
where "%V32AS%" >nul 2>nul
if errorlevel 1 (
    echo ERROR: %V32AS% is needed to build, but was not found in PATH
    goto :failed
)
where "%PACKROM%" >nul 2>nul
if errorlevel 1 (
    echo ERROR: %PACKROM% is needed to build, but was not found in PATH
    goto :failed
)
where "%PNG2VIRCON%" >nul 2>nul
if errorlevel 1 (
    echo ERROR: %PNG2VIRCON% is needed to build, but was not found in PATH
    goto :failed
)
where "%WAV2VIRCON%" >nul 2>nul
if errorlevel 1 (
    echo ERROR: %WAV2VIRCON% is needed to build, but was not found in PATH
    goto :failed
)

REM the optimizer is optional: without it (or with NO_OPT set) only the regular cartridge is built
set HAVE_OPT=0
set OPT_OK=0
if not defined NO_OPT (
    where "%V32OPT%" >nul 2>nul
    if not errorlevel 1 set HAVE_OPT=1
)
if "%HAVE_OPT%"=="0" echo note: v32opt not used -- skipping the optimized Opt build

REM create the output folders, since the development tools will not
if not exist bin mkdir bin

echo.
echo Optimize the ASM code
echo --------------------------
if "%HAVE_OPT%"=="1" (
    "%V32AS%" -E -P -c game.asm -o gamePre.asm --no-build-scripts
    if errorlevel 1 (
        echo warning: the source did not preprocess -- skipping the optimized Opt build
    ) else (
        "%V32OPT%" %V32OPT_FLAGS% gamePre.asm -o gameOpt.asm
        if errorlevel 1 (
            echo warning: v32opt failed -- skipping the optimized Opt build
        ) else (
            set OPT_OK=1
        )
    )
)

echo.
echo Assemble the ASM code
echo --------------------------
"%V32AS%" -c game.asm -o game.vbin --rom-xml game.xml --rom-xml-opt gameOpt.xml --no-build-scripts || goto :failed
if "%OPT_OK%"=="1" (
    "%V32AS%" -c gameOpt.asm -o gameOpt.vbin --no-build-scripts
    if errorlevel 1 (
        echo warning: the optimized code did not assemble -- skipping the optimized Opt build
        set OPT_OK=0
    )
)

echo.
echo Convert the textures and sounds
echo --------------------------
"%PNG2VIRCON%" gfx\font.png -o font.vtex || goto :failed
"%PNG2VIRCON%" gfx\bg.png -o bg.vtex || goto :failed
"%WAV2VIRCON%" snd\boom.wav -o boom.vsnd || goto :failed

echo.
echo Pack the ROM
echo --------------------------
"%PACKROM%" game.xml -o bin\game.v32 || goto :failed
if "%OPT_OK%"=="1" (
    "%PACKROM%" gameOpt.xml -o bin\gameOpt.v32
    if errorlevel 1 echo warning: the optimized Opt cartridge could not be packed
)
goto :succeeded

:failed
echo.
echo BUILD FAILED
exit /b 1

:succeeded
echo.
echo BUILD SUCCESSFUL
exit /b 0
